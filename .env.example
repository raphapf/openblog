# Vorlage für .env — diese Datei wird committet und enthält keine Geheimnisse.
# Kopieren mit:  cp .env.example .env

# API-Token aus dem hPanel: Konto → API → Token erstellen
HOSTINGER_API_TOKEN=""

# Schlüssel von https://openrouter.ai/keys — Recherche, Texte und Bilder
OPENROUTER_API_KEY=""

# Optional: andere als die voreingestellten Modelle verwenden.
# Die Voreinstellung ist erprobt, siehe docs/modelle.md.
# OPENROUTER_TEXT_MODEL="anthropic/claude-sonnet-5"
# OPENROUTER_IMAGE_MODEL="google/gemini-3.1-flash-lite-image"
