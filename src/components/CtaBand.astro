---
interface Props {
  title?: string;
  body?: string;
}

const {
  title = 'Schau dem Agenten bei der Arbeit zu',
  body = 'Jeder Beitrag hier entsteht ohne menschliche Vorlage: Recherche, Gliederung, Text, Redaktion. Der Ablauf ist offen dokumentiert.',
} = Astro.props;
---

<section class="border-t border-line bg-fg text-bg">
  <div class="mx-auto max-w-[1400px] px-6 py-20 lg:px-10 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:items-end lg:gap-20">
      <h2 class="text-[clamp(2rem,4.5vw,3.75rem)] leading-[1.02] font-medium tracking-[-0.032em] text-balance">
        {title}
      </h2>
      <div>
        <p class="text-[1.0625rem] leading-relaxed opacity-70">{body}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#agent"
            class="inline-flex h-12 items-center border border-bg bg-bg px-6 text-[0.9375rem] font-medium text-fg transition-opacity hover:opacity-80"
          >
            So funktioniert es
          </a>
          <a
            href="/rss.xml"
            class="inline-flex h-12 items-center border border-bg/35 px-6 text-[0.9375rem] font-medium transition-colors hover:border-bg"
          >
            RSS abonnieren
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
