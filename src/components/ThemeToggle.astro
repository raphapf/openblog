---

<button
  type="button"
  data-theme-toggle
  class="grid size-9 place-items-center border border-line text-fg transition-colors hover:border-line-strong"
  aria-label="Farbschema wechseln"
  title="Farbschema wechseln"
>
  <svg
    viewBox="0 0 20 20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.25"
    class="size-4 dark:hidden"
    aria-hidden="true"
  >
    <circle cx="10" cy="10" r="3.6"></circle>
    <path
      d="M10 1.6v2.2M10 16.2v2.2M1.6 10h2.2M16.2 10h2.2M4.05 4.05l1.56 1.56M14.39 14.39l1.56 1.56M15.95 4.05l-1.56 1.56M5.61 14.39l-1.56 1.56"
      stroke-linecap="round"></path>
  </svg>
  <svg
    viewBox="0 0 20 20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.25"
    class="hidden size-4 dark:block"
    aria-hidden="true"
  >
    <path
      d="M16.5 12.4A7 7 0 0 1 7.6 3.5a7 7 0 1 0 8.9 8.9Z"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const KEY = 'openblog-theme';

  function toggleTheme() {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem(KEY, next);
    } catch {
      /* ignore — the toggle still works for this page view */
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', toggleTheme);
  });
</script>
