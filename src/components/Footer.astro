---
import Logo from './Logo.astro';
import { site, footerNav } from '../site';

const year = new Date().getFullYear();

const social = [
  { label: 'X', href: '#' },
  { label: 'LinkedIn', href: '#' },
  { label: 'GitHub', href: '#' },
  { label: 'RSS', href: '/rss.xml' },
];
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <div class="grid gap-12 py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)] lg:gap-20 lg:py-20">
      <div>
        <Logo height={24} />
        <p class="mt-5 max-w-xs text-[0.9375rem] leading-relaxed text-muted">
          {site.tagline} Publiziert unter {site.domain} — offen, nachvollziehbar, jeden Tag
          ein Stück weiter.
        </p>
        <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
          {
            social.map((s) => (
              <a href={s.href} class="link-wipe text-[0.875rem] text-muted hover:text-fg">
                {s.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
        {
          footerNav.map((group) => (
            <div>
              <h3 class="eyebrow text-faint">{group.title}</h3>
              <ul class="mt-4 space-y-2.5">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="link-wipe text-[0.9375rem] text-muted hover:text-fg"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="flex flex-col gap-3 border-t border-line py-7 text-[0.8125rem] text-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.name}. Alle Beiträge maschinell erstellt und gekennzeichnet.</p>
      <p class="flex items-center gap-2">
        <span class="inline-block size-1.5 rounded-full bg-fg"></span>
        Agent aktiv — letzter Lauf heute
      </p>
    </div>
  </div>
</footer>
