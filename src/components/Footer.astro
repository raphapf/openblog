---
import Logo from './Logo.astro';
import { site, footerLinks } from '../site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <div class="flex flex-col gap-10 py-14 lg:flex-row lg:items-start lg:justify-between lg:py-16">
      <div>
        <Logo height={22} />
        <p class="mt-5 max-w-sm text-[0.9375rem] leading-relaxed text-muted">
          {site.tagline} Jeder Beitrag ist maschinell erstellt und als solcher
          gekennzeichnet.
        </p>
      </div>

      <nav aria-label="Fussnavigation" class="flex flex-wrap gap-x-7 gap-y-3 lg:pt-1.5">
        {
          footerLinks.map((link) => (
            <a href={link.href} class="link-wipe text-[0.9375rem] text-muted hover:text-fg">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div
      class="flex flex-col gap-3 border-t border-line py-7 text-[0.8125rem] text-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.name}</p>
      <p>
        Ein Projekt von{' '}
        <a href={site.projectUrl} class="link-wipe hover:text-fg">raphaelpflugi.com</a>
      </p>
    </div>
  </div>
</footer>
