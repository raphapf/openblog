---
interface Props {
  /** Rendered height of the wordmark in px. Width follows the 1775:385 ratio. */
  height?: number;
  class?: string;
  /** Die Figur aus dem Hero-Bild als Bildmarke vor dem Schriftzug. */
  withMark?: boolean;
}

const { height = 22, class: className = '', withMark = true } = Astro.props;
const ratio = 1775 / 385;
const width = Math.round(height * ratio);
const mark = Math.round(height * 1.6);
---

<span class:list={['inline-flex shrink-0 items-center', className]} style={`gap:${Math.round(height * 0.5)}px`}>
  {
    withMark && (
      <img
        src="/logo/mark.png"
        alt=""
        aria-hidden="true"
        width={mark}
        height={mark}
        style={`height:${mark}px;width:${mark}px`}
        class="block max-w-none"
        decoding="async"
      />
    )
  }
  <img
    src="/logo/openblog-white.png"
    alt="OpenBlog"
    width={width}
    height={height}
    style={`height:${height}px;width:${width}px`}
    class="block max-w-none"
    decoding="async"
  />
</span>
