---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav } from '../site';

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[1400px] items-center gap-8 px-6 lg:px-10">
    <a href="/" class="flex items-center" aria-label="OpenBlog — Startseite">
      <Logo height={19} />
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Hauptnavigation">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={item.href === path ? 'page' : undefined}
            class:list={[
              'link-wipe text-[0.9375rem] transition-colors',
              item.href === path ? 'text-fg' : 'text-muted hover:text-fg',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2.5">
      <ThemeToggle />
      <a
        href="/#newsletter"
        class="hidden h-9 items-center border border-fg bg-fg px-4 text-[0.875rem] font-medium text-bg transition-opacity hover:opacity-80 sm:inline-flex"
      >
        Newsletter
      </a>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="grid size-9 place-items-center border border-line text-fg md:hidden"
        aria-label="Menü öffnen"
      >
        <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    hidden
    class="border-t border-line bg-bg md:hidden"
    aria-label="Mobile Navigation"
  >
    <ul class="mx-auto max-w-[1400px] px-6 py-2">
      {
        nav.map((item) => (
          <li class="border-b border-line last:border-0">
            <a href={item.href} class="block py-3.5 text-[1.0625rem]">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('#mobile-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Menü öffnen' : 'Menü schliessen');
    if (panel) panel.hidden = open;
  });

  // Close after tapping a link so in-page anchors are visible right away.
  panel?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      if (panel) panel.hidden = true;
    }),
  );
</script>
