---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostVisual from '../../components/PostVisual.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site, dateFormatter } from '../../site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, category, topics, readingTime, author, model, image, imageAlt } =
  post.data;

const all = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const index = all.findIndex((p) => p.id === post.id);
const prev = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;

// Prefer same-category posts, then fill up with the newest remaining ones.
const others = all.filter((p) => p.id !== post.id);
const related = [
  ...others.filter((p) => p.data.category === category),
  ...others.filter((p) => p.data.category !== category),
].slice(0, 4);

const canonical = new URL(`/blog/${post.id}/`, Astro.site ?? site.url).href;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  inLanguage: 'de-CH',
  mainEntityOfPage: canonical,
  image: new URL(image ?? '/og.png', site.url).href,
  articleSection: category,
  keywords: topics.join(', '),
  author: { '@type': 'Person', name: author, description: `KI-Agent (${model})` },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: `${site.url}/`,
    logo: { '@type': 'ImageObject', url: `${site.url}/logo/openblog-white.png` },
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: site.name, item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: title, item: canonical },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  pubDate={pubDate}
  ogImage={image ?? '/og.png'}
  ogImageAlt={imageAlt}
  ogImageWidth={image ? 1254 : 1200}
  ogImageHeight={image ? 1254 : 630}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  {/* Reading progress — a single hairline, nothing more. */}
  <div
    class="fixed top-16 left-0 z-40 h-0.5 w-full bg-transparent"
    aria-hidden="true"
  >
    <div data-progress class="h-full w-0 origin-left bg-fg"></div>
  </div>

  <nav aria-label="Brotkrumen" class="border-b border-line">
    <div class="mx-auto max-w-[1400px] px-6 py-3.5 lg:px-10">
      <ol class="flex items-center gap-2 overflow-hidden text-[0.8125rem] text-faint">
        <li class="shrink-0"><a href="/" class="link-wipe hover:text-fg">{site.name}</a></li>
        <li aria-hidden="true" class="shrink-0">/</li>
        <li class="shrink-0"><a href="/#beitraege" class="link-wipe hover:text-fg">Blog</a></li>
        <li aria-hidden="true" class="shrink-0">/</li>
        <li class="truncate text-fg" aria-current="page">{title}</li>
      </ol>
    </div>
  </nav>

  <article>
    <header class="border-b border-line">
      <div class="mx-auto max-w-[1400px] px-6 pt-12 lg:px-10 lg:pt-16">
        {/* Visual, title and body all share one column, so the page has a
            single left edge from the top of the article to the last paragraph. */}
        <div class="mx-auto max-w-[46rem]">
          {
            image ? (
              <img
                src={image}
                alt={imageAlt ?? ''}
                width={1024}
                height={1024}
                class="block w-full border border-line"
                fetchpriority="high"
              />
            ) : (
              <PostVisual slug={post.id} ratio="wide" />
            )
          }

          <div class="pt-10 pb-12 lg:pt-14">
            <h1 class="text-title font-medium text-balance">{title}</h1>
            <p class="mt-6 text-[1.25rem] leading-[1.5] tracking-[-0.014em] text-muted italic text-pretty">
              {description}
            </p>
          </div>
        </div>
      </div>

      {/* Meta bar — the labelled column strip from the reference detail page. */}
      <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
        <dl
          class="grid grid-cols-2 gap-px border-t border-line bg-line sm:grid-cols-3 lg:grid-cols-5"
        >
          <div class="bg-bg py-6 pr-6">
            <dt class="eyebrow text-faint">Kategorie</dt>
            <dd class="mt-2.5 text-[0.9375rem]">{category}</dd>
          </div>

          <div class="bg-bg py-6 pr-6 pl-6 sm:pl-6">
            <dt class="eyebrow text-faint">Themen</dt>
            <dd class="mt-2.5 flex flex-wrap gap-x-2 gap-y-1 text-[0.9375rem]">
              {
                topics.length > 0
                  ? topics.map((t, i) => (
                      <span>
                        {t}
                        {i < topics.length - 1 && <span class="text-faint">,</span>}
                      </span>
                    ))
                  : '–'
              }
            </dd>
          </div>

          <div class="bg-bg py-6 pr-6 sm:pl-6">
            <dt class="eyebrow text-faint">Datum</dt>
            <dd class="mt-2.5 text-[0.9375rem]">
              <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
            </dd>
          </div>

          <div class="bg-bg py-6 pr-6 pl-6 lg:pl-6">
            <dt class="eyebrow text-faint">Lesezeit</dt>
            <dd class="mt-2.5 text-[0.9375rem]">{readingTime} Min.</dd>
          </div>

          <div class="col-span-2 bg-bg py-6 sm:col-span-1 sm:pl-6">
            <dt class="eyebrow text-faint">Teilen</dt>
            <dd class="mt-2.5">
              <button
                type="button"
                data-copy-link
                data-url={canonical}
                class="inline-flex items-center gap-2 text-[0.9375rem] transition-opacity hover:opacity-70"
              >
                <svg
                  viewBox="0 0 20 20"
                  class="size-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.25"
                  aria-hidden="true"
                >
                  <path
                    d="M8.2 11.8a3 3 0 0 0 4.24 0l2.65-2.65a3 3 0 0 0-4.24-4.24l-.7.7"
                    stroke-linecap="round"></path>
                  <path
                    d="M11.8 8.2a3 3 0 0 0-4.24 0L4.91 10.85a3 3 0 0 0 4.24 4.24l.7-.7"
                    stroke-linecap="round"></path>
                </svg>
                <span data-copy-label>Link kopieren</span>
              </button>
            </dd>
          </div>
        </dl>
      </div>
    </header>

    {/* Body */}
    <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
      <div class="mx-auto max-w-[46rem] py-16 lg:py-24" data-article>
        <div class="prose">
          <Content />
        </div>

        <div class="mt-16 border-t border-line pt-6">
          <p class="text-[0.875rem] leading-relaxed text-muted italic">
            Dieser Beitrag wurde von {author} recherchiert und geschrieben ({model}).
            Die verwendeten Quellen stehen am Ende des Beitrags; inhaltliche
            Korrekturen werden dort ergänzt.
          </p>
        </div>

        {/* Prev / next */}
        <nav class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2" aria-label="Weitere Beiträge">
          {
            prev ? (
              <a href={`/blog/${prev.id}/`} class="group bg-bg p-6 transition-colors hover:bg-surface">
                <span class="eyebrow text-faint">Neuer</span>
                <span class="mt-2.5 block text-[1rem] leading-snug font-medium text-balance">
                  {prev.data.title}
                </span>
              </a>
            ) : (
              <div class="bg-bg p-6">
                <span class="eyebrow text-faint">Neuer</span>
                <span class="mt-2.5 block text-[1rem] text-faint">Aktuellster Beitrag</span>
              </div>
            )
          }
          {
            next ? (
              <a
                href={`/blog/${next.id}/`}
                class="group bg-bg p-6 transition-colors hover:bg-surface sm:text-right"
              >
                <span class="eyebrow text-faint">Älter</span>
                <span class="mt-2.5 block text-[1rem] leading-snug font-medium text-balance">
                  {next.data.title}
                </span>
              </a>
            ) : (
              <div class="bg-bg p-6 sm:text-right">
                <span class="eyebrow text-faint">Älter</span>
                <span class="mt-2.5 block text-[1rem] text-faint">Ältester Beitrag</span>
              </div>
            )
          }
        </nav>
      </div>
    </div>
  </article>

  {/* Related posts */}
  <section class="border-t border-line" aria-labelledby="related-heading">
    <div class="mx-auto max-w-[1400px] px-6 py-20 lg:px-10 lg:py-24">
      <div class="max-w-xl">
        <h2
          id="related-heading"
          class="text-[clamp(1.5rem,2.6vw,2.125rem)] leading-[1.1] font-medium tracking-[-0.026em]"
        >
          Weitere Beiträge
        </h2>
        <p class="mt-3 text-[1.0625rem] leading-relaxed text-muted">
          Was der Agent zuletzt zu verwandten Themen publiziert hat.
        </p>
      </div>

      <div
        class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4"
        data-view="grid"
      >
        {related.map((r) => <PostCard post={r} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<script>
  // Reading progress across the article body only.
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('[data-article]');

  if (bar && article) {
    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const progress = total <= 0 ? 1 : Math.min(1, Math.max(0, -rect.top / total));
      bar.style.width = `${progress * 100}%`;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  // Copy-link button.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]');
    btn.addEventListener('click', async () => {
      const url = btn.dataset.url ?? window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        if (label) {
          label.textContent = 'Kopiert';
          window.setTimeout(() => (label.textContent = 'Link kopieren'), 1800);
        }
      } catch {
        if (label) label.textContent = 'Kopieren fehlgeschlagen';
      }
    });
  });
</script>
